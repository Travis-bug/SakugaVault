# Production environment for docker-compose.prod.yml.
# Copy to `.env.prod` ON THE SERVER and fill in real values. Never commit .env.prod.
#   cp .env.prod.example .env.prod && nano .env.prod
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build

# ---- Public site ----
# The domain whose DNS A/AAAA record points at this server. Caddy gets a free
# Let's Encrypt cert for it automatically. No http:// prefix.
DOMAIN=sakugavault.com
# Email Let's Encrypt uses for expiry notices.
ACME_EMAIL=you@example.com
# Cloudflare API token for the DNS-01 TLS challenge (lets HTTPS issue/renew while
# Cloudflare's proxy is ON). Create at Cloudflare > My Profile > API Tokens:
#   Template "Edit zone DNS" > Zone Resources: Include > Specific zone > sakugavault.com
# Paste the token here (server only — never commit .env.prod).
CLOUDFLARE_API_TOKEN=CHANGE_ME_cloudflare_zone_dns_token

# ---- Database (lives in the mysql container; volume-backed) ----
MYSQL_DATABASE=sakuga-vault-db
MYSQL_USER=Sakuga_admin
MYSQL_PASSWORD=CHANGE_ME_strong_password
MYSQL_ROOT_PASSWORD=CHANGE_ME_different_strong_password

# ---- Auth ----
# Long random string (>= 32 chars). Generate: openssl rand -base64 48
JWT_SIGNING_KEY=CHANGE_ME_long_random_secret

# ---- DB backups (db-backup sidecar) ----
# Default 86400 = daily. 432000 = every 5 days (more potential data loss).
BACKUP_INTERVAL_SECONDS=86400
BACKUP_KEEP=14
# OPTIONAL offsite copy after each dump. $BACKUP_FILE is the gzipped dump path.
# Leave empty to keep dumps local. Example (Azure Blob via azcopy):
#   OFFSITE_UPLOAD_CMD=azcopy copy "$BACKUP_FILE" "https://acct.blob.core.windows.net/backups?<SAS>"
OFFSITE_UPLOAD_CMD=

# ---- Scraper resolvers ----
SCRAPER_REQUEST_TIMEOUT_SECONDS=75
ANIMEPAHE_RESOLVER_ENABLED=true
# These cost money per request; enable only if you have credits.
CRAWLEE_RESOLVER_ENABLED=false
SCRAPY_RESOLVER_ENABLED=false
SCRAPINGBEE_API_KEY=
CRAWLEE_TARGET_BASE_URL=
SCRAPERAPI_API_KEY=
SCRAPY_TARGET_BASE_URL=

# ---- Misc ----
TZ=UTC
FLARESOLVERR_LOG_LEVEL=info
