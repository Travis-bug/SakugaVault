# Production edge: terminates TLS and forwards to the web container, which
# already serves the SPA and proxies /api -> api:8080 (including the Range-aware
# stream proxy). Keeping that routing in nginx means Caddy only handles TLS +
# HTTP/2/3, and we don't re-implement the streaming proxy here.
#
# TLS via Cloudflare DNS-01 challenge: works even with Cloudflare's proxy
# (orange cloud) turned on, because validation happens over a DNS TXT record
# (written with CLOUDFLARE_API_TOKEN) instead of HTTP. Certs auto-renew.
# Pair this with Cloudflare SSL/TLS mode "Full (strict)" for end-to-end HTTPS.
{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
	reverse_proxy web:80
}

# Serve a cert for www too (so Cloudflare's Full-strict handshake succeeds when
# it connects with SNI www.<domain>), and redirect it to the apex.
www.{$DOMAIN} {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
	redir https://{$DOMAIN}{uri} permanent
}
